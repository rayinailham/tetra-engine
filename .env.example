# Tetra Engine Configuration
# Copy this file to .env and adjust values

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tetra
DB_SSLMODE=disable

# Flux WMS API
FLUX_BASE_URL=https://mock-api-anteraja.vercel.app
FLUX_TIMEOUT=30s
FLUX_RETRY_MAX=3

# Scheduler Intervals
SCHEDULER_ORDER_SYNC_INTERVAL=15m
SCHEDULER_CARTON_SYNC_INTERVAL=30m
SCHEDULER_RECOMMENDATION_INTERVAL=5m
SCHEDULER_PUSH_INTERVAL=5m

# HTTP Server
HTTP_PORT=8080

# Logging
LOG_LEVEL=info
LOG_FORMAT=text

# Created By (for Flux API push)
CREATED_BY=Rayinailham9@gmail.com
